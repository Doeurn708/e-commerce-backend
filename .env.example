APP_NAME=Laravel
# local for development; production on Railway. APP_DEBUG must be false in
# production or stack traces and environment values leak in error responses.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Local development uses the explicit DB_* variables below.
#
# On Railway you can instead set a single variable and leave DB_* unset:
#   DB_CONNECTION=pgsql
#   DB_URL=${{Postgres.DATABASE_URL}}
# (or link the Postgres service so Railway injects PGHOST/PGPORT/PGDATABASE/
#  PGUSER/PGPASSWORD - config/database.php falls back to those automatically).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=e_commerce
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production behind HTTPS (Railway) so the session cookie gets Secure.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Never commit a real secret; fill this in locally or on the server.
CLOUDINARY_URL=

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Socialite). GOOGLE_REDIRECT_URI must exactly match an entry
# registered in Google Cloud Console -> Credentials -> your OAuth client.
# Local:  http://127.0.0.1:8000/api/auth/google/callback
# Prod:   https://store-padon708.up.railway.app/api/auth/google/callback
# Leave it unset to derive it automatically from APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://store-padon708.up.railway.app/api/auth/google/callback

# Single SPA origin. GoogleAuthController appends /auth/google/callback to this
# when it builds the post-OAuth redirect, so it must not be a list.
# Local: http://localhost:5173  Prod:
FRONTEND_URL=https://store-padon.vercel.app

# Comma-separated list of origins allowed to call this API (config/cors.php).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://store-padon.vercel.app

# ==========================================================================
# Production deployment on Railway (set these in the service's Variables tab;
# this file is NOT deployed). Values shown are the production values.
# ==========================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=            # php artisan key:generate --show  (paste the result)
# APP_URL=https://store-padon708.up.railway.app
#                     # optional: auto-derived from RAILWAY_PUBLIC_DOMAIN when empty
#
# Session (bearer-token API; keep SESSION_DOMAIN unset - "sync" is NOT a domain):
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=     # leave empty / unset! ("sync" is invalid and breaks cookies)
#
# Queue (OTP emails and processes are synchronous; do NOT use "database" without a worker):
# QUEUE_CONNECTION=sync
#
# Database - set DB_CONNECTION and one of the following, then leave DB_HOST etc.
# unset so the Railway values are used:
#   DB_CONNECTION=pgsql
#   DB_URL=${{Postgres.DATABASE_URL}}     # reference to the Postgres service
#   # or link Postgres so PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD are injected
#
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
# FRONTEND_URL=https://store-padon.vercel.app
# CORS_ALLOWED_ORIGINS=https://store-padon.vercel.app
# GOOGLE_REDIRECT_URI=https://store-padon708.up.railway.app/api/auth/google/callback
#
# Mail (OTP emails are sent via MAIL_MAILER; "log" writes them to the log only):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls   # or ssl for port 465; MAIL_SCHEME also works
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="E-commerce"
